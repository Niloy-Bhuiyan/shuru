# ════════════════════════════════════════════════════════════════
# SHURU — environment configuration
# Copy to .env.local and fill in. .env.local is git-ignored; never commit it.
# The full provisioning walkthrough is in docs/DEPLOYMENT.md.
# ════════════════════════════════════════════════════════════════

# ── Supabase (REQUIRED) ─────────────────────────────────────────
# Shuru is a database-backed product; it does not run without these.
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SERVER-ONLY SECRET. Never prefix with NEXT_PUBLIC_.
# Bypasses RLS. Used by ingestion, scheduled jobs and admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site URL (REQUIRED in production) ───────────────────────────
# Absolute origin of this deployment, no trailing slash. Used to build
# OAuth callback URLs and the links inside verification / password-reset
# emails. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OAuth (optional) ────────────────────────────────────────────
# Google and GitHub sign-in are configured in the Supabase Dashboard
# (Authentication → Providers), NOT here — Supabase holds the client
# secrets. These flags only control whether Shuru renders the buttons,
# so the UI never offers a provider that would fail on click.
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=false

# ── Internship ingestion ────────────────────────────────────────
# Keyless public sources. Set to false to disable a source.
INGEST_REMOTEOK_ENABLED=true
INGEST_ARBEITNOW_ENABLED=true

# Lever — comma-separated public board slugs to pull from.
# A slug is the segment in https://jobs.lever.co/<slug>
# Empty ⇒ adapter is inactive.
LEVER_COMPANIES=

# Ashby — comma-separated public job-board names.
# The name is the segment in https://jobs.ashbyhq.com/<name>
# Empty ⇒ adapter is inactive.
ASHBY_COMPANIES=

# Adzuna — optional aggregator. Both values required to activate.
# Register free at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ISO country code for the Adzuna endpoint (e.g. gb, us, in).
ADZUNA_COUNTRY=gb

# ── Scheduled jobs + protected routes ───────────────────────────
# Shared secret required by POST /api/ingest and POST /api/cron/*.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Google Gemini (optional — powers AI assistance) ─────────────
# https://aistudio.google.com/apikey  (free tier, no card)
# Enables the agent chat, resume structuring on upload, and EXPLAIN THIS.
# Unset ⇒ those entry points hide themselves; rule-based features are
# unaffected and nothing is faked.
GEMINI_API_KEY=
# Optional model override. Default: gemini-flash-lite-latest
GEMINI_MODEL=
