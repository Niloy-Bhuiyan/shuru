#==============================================================================
# SHURU - environment configuration
#
# Copy to .env.local and fill in. .env.local is git-ignored; never commit it.
# The full provisioning walkthrough is in docs/DEPLOYMENT.md.
#==============================================================================


#------------------------------------------------------------------------------
# Local tooling (optional)
#------------------------------------------------------------------------------
# Direct Postgres URI, used only by `npm run migrate` to apply the files in
# supabase/migrations. Supabase Dashboard -> Project Settings -> Database
# -> Connection string -> URI. Not read by the app at runtime.
SUPABASE_DB_URL=


#------------------------------------------------------------------------------
# Supabase (REQUIRED)
#------------------------------------------------------------------------------
# Shuru is a database-backed product; it does not run without these. Without
# them every page renders an explicit "not configured" state rather than
# simulating a backend.
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key - SERVER-ONLY SECRET. Never prefix with NEXT_PUBLIC_.
# Bypasses RLS. Used by ingestion, scheduled jobs and admin operations.
SUPABASE_SERVICE_ROLE_KEY=


#------------------------------------------------------------------------------
# Site URL (REQUIRED in production)
#------------------------------------------------------------------------------
# Absolute origin of this deployment, no trailing slash. Used to build OAuth
# callback URLs and the links inside verification / password-reset emails.
# Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


#------------------------------------------------------------------------------
# OAuth (optional)
#------------------------------------------------------------------------------
# Google and GitHub sign-in are configured in the Supabase Dashboard
# (Authentication -> Providers), NOT here - Supabase holds the client secrets.
# These flags only control whether Shuru renders the buttons, so the UI never
# offers a provider that would fail on click.
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=false


#------------------------------------------------------------------------------
# Internship ingestion
#------------------------------------------------------------------------------
# Keyless public sources. Set to false to disable a source.
INGEST_REMOTEOK_ENABLED=true
INGEST_ARBEITNOW_ENABLED=true

# Lever - comma-separated public board slugs to pull from.
# A slug is the segment in https://jobs.lever.co/<slug>
# Empty => adapter is inactive.
LEVER_COMPANIES=

# Ashby - comma-separated public job-board names.
# The name is the segment in https://jobs.ashbyhq.com/<name>
# Empty => adapter is inactive.
ASHBY_COMPANIES=

# Adzuna - optional aggregator. Both values required to activate.
# Register free at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ISO country code for the Adzuna endpoint (e.g. gb, us, in).
ADZUNA_COUNTRY=gb


#------------------------------------------------------------------------------
# Scheduled jobs + protected routes
#------------------------------------------------------------------------------
# Shared secret required by POST /api/ingest and POST
# /api/notifications/dispatch (header x-ingest-secret, or ?secret=). Their GET
# status endpoints are gated by the same value, because they name every job
# board and email provider this deployment uses.
# Leave unset only for local development - any deployment reachable from the
# internet must set it.
# Generate with: openssl rand -hex 32
INGEST_SECRET=

# Secret for the Vercel Cron entry point, GET /api/cron?job=...
#
# REQUIRED IF YOU DEPLOY WITH THE CRON JOBS IN vercel.json. Both schedules
# (ingest every 6h, notification dispatch every 15m) call /api/cron, and it
# returns 503 "cron_not_configured" when this is unset rather than running an
# unauthenticated job - a public URL that triggers ingestion is a
# denial-of-wallet vector. An unset value means the jobs silently never run.
#
# Vercel Cron cannot attach custom headers; it sends
# `Authorization: Bearer $CRON_SECRET`, which is why this is separate from
# INGEST_SECRET above. Set it in the Vercel environment only.
# Generate with: openssl rand -hex 32
CRON_SECRET=


#------------------------------------------------------------------------------
# AI provider (optional - powers AI assistance)
#------------------------------------------------------------------------------
# Two providers are supported and either one is enough. If BOTH keys are set,
# Anthropic wins: Gemini's free tier makes it the easy one to leave lying
# around, so an explicitly-added Anthropic key is the more deliberate signal.
# Unset one to force the other.
#
# With neither set, every AI entry point hides itself. The rule-based features
# (eligibility, Reality Check, ATS scoring, JD match) do not use a provider at
# all and are unaffected.

# -- Anthropic (Claude) --
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5
# Set a cheaper tier (e.g. claude-haiku-4-5) to trade capability for cost.
# Current model ids carry NO date suffix.
ANTHROPIC_MODEL=

# -- Google Gemini --
# https://aistudio.google.com/apikey  (free tier, no card)
GEMINI_API_KEY=
# Optional model override. Default: gemini-flash-lite-latest
# The default is a rolling alias on purpose - pinned versions like
# gemini-2.5-flash get retired and start 404-ing for new keys.
GEMINI_MODEL=


#------------------------------------------------------------------------------
# Retrieval service (optional - services/rag)
#------------------------------------------------------------------------------
# The Python service that answers questions about listings from the text those
# listings publish, with a citation per claim. Both values are SERVER-ONLY and
# must never carry a NEXT_PUBLIC_ prefix.
#
# Unset => /api/ask reports itself unavailable and the UI hides the feature.
# Nothing degrades to a guessed answer.
#
# SHURU_RAG_SERVICE_TOKEN must be the SAME value the service is started with
# (see services/rag/.env.example).
SHURU_RAG_URL=
SHURU_RAG_SERVICE_TOKEN=


#------------------------------------------------------------------------------
# Email notification delivery (optional)
#------------------------------------------------------------------------------
# Shuru writes notifications as database rows regardless. These control
# whether they are ALSO emailed. Unset = in-app only; `emailed_at` stays null
# so nothing claims a delivery that did not happen.
#
# EMAIL_PROVIDER selects the adapter explicitly: resend | postmark | console
# ("console" logs instead of sending - development only; it is refused in
# production unless EMAIL_ALLOW_CONSOLE=true, because a console send stamps
# emailed_at and would falsify the delivery record).
EMAIL_PROVIDER=

# Verified sender, e.g. "Shuru <alerts@yourdomain.com>". The domain must be
# verified with your provider or every send is rejected.
EMAIL_FROM=

# Exactly one of these, matching EMAIL_PROVIDER above.
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=


#------------------------------------------------------------------------------
# Browser push notifications (optional)
#------------------------------------------------------------------------------
# VAPID keypair for Web Push. Generate locally, no account needed:
#   node scripts/generate-vapid-keys.mjs
# The public key is shipped to the browser; the private key is server-only.
# Rotating the keypair invalidates every existing subscription at once.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: URL identifying you to the push service, e.g.
# mailto:you@yourdomain.com
VAPID_SUBJECT=
