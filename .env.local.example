# ── Supabase (required for auth + data; app runs on local seed data without it) ──
# Get all from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# service_role key — SERVER-ONLY SECRET. Never prefix with NEXT_PUBLIC_.
# Required only for listing ingestion in Supabase mode: /api/ingest writes the
# `opportunities` table, which is RLS SELECT-only for the anon key. Unset ⇒ the
# refresh route returns a clear `service_role_key_missing` error (nothing else
# is affected). Same API page → "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini (OPTIONAL — powers all AI features) ──
# Get free key from: https://aistudio.google.com/apikey  (no card needed)
# Enables: the agent chat (/agent), résumé structuring on upload, and the
# "EXPLAIN THIS" button. If left as placeholder or empty, those AI entry points
# hide themselves and everything else works (honest, rule-based, on seed data).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: override the Gemini model (default: gemini-flash-lite-latest — fast,
# cheap, and always tracks the current flash-lite model). Use this if your
# key/region reports the default as not found — e.g. GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL=

# ── Remote listing ingestion (optional) ──
# /api/ingest pulls internship/junior roles from RemoteOK + Arbeitnow (both
# free, public, no key needed). If you set a secret below, POST /api/ingest
# will require it (header x-ingest-secret or ?secret=). Leave unset to keep
# the route open (a 15-minute cooldown still applies).
INGEST_SECRET=
