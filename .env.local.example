# SHURU â€” environment configuration
# Copy to .env.local and fill in. .env.local is git-ignored; never commit it.
# The full provisioning walkthrough is in docs/DEPLOYMENT.md.
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€ Local tooling (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Direct Postgres URI, used only by `npm run migrate` to apply files in
# supabase/migrations. Supabase Dashboard -> Project Settings -> Database
# -> Connection string -> URI. Not read by the app at runtime.
SUPABASE_DB_URL=

# â”€â”€ Supabase (REQUIRED) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Shuru is a database-backed product; it does not run without these.
# Supabase Dashboard â†’ Project Settings â†’ API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key â€” SERVER-ONLY SECRET. Never prefix with NEXT_PUBLIC_.
# Bypasses RLS. Used by ingestion, scheduled jobs and admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# â”€â”€ Site URL (REQUIRED in production) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Absolute origin of this deployment, no trailing slash. Used to build
# OAuth callback URLs and the links inside verification / password-reset
# emails. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# â”€â”€ OAuth (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Google and GitHub sign-in are configured in the Supabase Dashboard
# (Authentication â†’ Providers), NOT here â€” Supabase holds the client
# secrets. These flags only control whether Shuru renders the buttons,
# so the UI never offers a provider that would fail on click.
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=false

# â”€â”€ Internship ingestion â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Keyless public sources. Set to false to disable a source.
INGEST_REMOTEOK_ENABLED=true
INGEST_ARBEITNOW_ENABLED=true

# Lever â€” comma-separated public board slugs to pull from.
# A slug is the segment in https://jobs.lever.co/<slug>
# Empty â‡’ adapter is inactive.
LEVER_COMPANIES=

# Ashby â€” comma-separated public job-board names.
# The name is the segment in https://jobs.ashbyhq.com/<name>
# Empty â‡’ adapter is inactive.
ASHBY_COMPANIES=

# Adzuna â€” optional aggregator. Both values required to activate.
# Register free at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ISO country code for the Adzuna endpoint (e.g. gb, us, in).
ADZUNA_COUNTRY=gb

# â”€â”€ Scheduled jobs + protected routes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Shared secret required by POST /api/ingest (header x-ingest-secret, or
# ?secret=). Leave unset only for local development â€” any deployment
# reachable from the internet must set it.
# Generate with: openssl rand -hex 32
INGEST_SECRET=

# â”€â”€ Google Gemini (optional â€” powers AI assistance) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# https://aistudio.google.com/apikey  (free tier, no card)
# Enables the agent chat, resume structuring on upload, and EXPLAIN THIS.
# Unset â‡’ those entry points hide themselves; rule-based features are
# unaffected and nothing is faked.
GEMINI_API_KEY=
# Optional model override. Default: gemini-flash-lite-latest
GEMINI_MODEL=

# ── Email notification delivery (optional) ──────────────────────
# Shuru writes notifications as database rows regardless. These control
# whether they are ALSO emailed. Unset = in-app only; `emailed_at` stays
# null so nothing claims a delivery that did not happen.
#
# EMAIL_PROVIDER selects the adapter explicitly: resend | postmark | console
# ("console" logs instead of sending — development only; it is refused in
# production unless EMAIL_ALLOW_CONSOLE=true, because a console send stamps
# emailed_at and would falsify the delivery record).
EMAIL_PROVIDER=

# Verified sender, e.g. "Shuru <alerts@yourdomain.com>". The domain must be
# verified with your provider or every send is rejected.
EMAIL_FROM=

# Exactly one of these, matching EMAIL_PROVIDER above.
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# ── Browser push notifications (optional) ───────────────────────
# VAPID keypair for Web Push. Generate locally, no account needed:
#   node scripts/generate-vapid-keys.mjs
# The public key is shipped to the browser; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: URL identifying you to the push service, e.g.
# mailto:you@yourdomain.com
VAPID_SUBJECT=
