# Shuru RAG service — environment.
# Copy to .env (git-ignored) and fill in.
# Every variable is prefixed SHURU_RAG_ so it can never be confused with the
# web app's own ANTHROPIC_* / DATABASE_* names.

# ── REQUIRED for retrieval ──────────────────────────────────────────────
# Same Postgres as the web app. Supabase Dashboard -> Project Settings ->
# Database -> Connection string -> URI (replace [YOUR-PASSWORD]).
# Uses the service role, which bypasses RLS — the visibility filter is
# re-applied in SQL in app/db.py.
SHURU_RAG_DATABASE_URL=

# Shared bearer token for the Next.js -> service hop. Server-to-server only;
# never sent to a browser. Unset => the service refuses every request rather
# than running open.
# Generate with: openssl rand -hex 32
SHURU_RAG_SERVICE_TOKEN=

# ── OPTIONAL: written answers ───────────────────────────────────────────
# Without this, retrieval still works and returns cited passages; only the
# prose step is unavailable, and /ask says so via abstain_reason.
SHURU_RAG_ANTHROPIC_API_KEY=
# Default: claude-opus-5
SHURU_RAG_ANTHROPIC_MODEL=

# ── OPTIONAL: tuning ────────────────────────────────────────────────────
# Only 'local' is implemented — a real ONNX model in-process, no API key.
SHURU_RAG_EMBEDDING_PROVIDER=local
# Must be a 384-dim model; the vector column is vector(384) (migration 0013).
SHURU_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

SHURU_RAG_RETRIEVAL_TOP_K=8
# Cosine distance upper bound. Raising it makes the service answer from
# weaker evidence — this is the knob that decides when it abstains.
SHURU_RAG_MAX_COSINE_DISTANCE=0.75
SHURU_RAG_MIN_CHUNKS_TO_ANSWER=1
SHURU_RAG_DAILY_ANSWER_LIMIT=30
